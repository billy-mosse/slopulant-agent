[Unit]
Description=DupCheck Discord duplicate alerts and reaction feedback (reads data/watcher.db)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/slopulant-agent/discord_worker
ExecStart=%h/slopulant-agent/discord_worker/.venv/bin/python -m dupcheck_discord run
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
