# Copy to .env; paste the Discord bot token there, never in chat or source code.
DISCORD_BOT_TOKEN=

# A numeric channel ID takes priority. Otherwise, resolve this channel name.
DISCORD_CHANNEL_ID=
DISCORD_CHANNEL_NAME=slop-factory

# Local examples use an inbox. See README for the GB10's actual shared database.
DUPCHECK_DB_PATH=data/dupcheck.sqlite3
DUPCHECK_SOURCE=inbox
DUPCHECK_REPOSITORY=team repository
POLL_INTERVAL_SECONDS=3
FEEDBACK_SYNC_SECONDS=60

# Optional comma-separated Discord user IDs. Empty allows all human reviewers.
DISCORD_REVIEWER_IDS=
